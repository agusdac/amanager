# PostgreSQL (compose.dev.yml)
DATABASE_URL=postgres://hilko:hilko_dev@localhost:5432/hilko

# Session signing (use 32+ random bytes in production)
NUXT_SESSION_SECRET=change-me-to-a-long-random-string

# App URL (password reset links)
NUXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP — Mailpit in dev (compose.dev.yml)
NUXT_SMTP_HOST=localhost
NUXT_SMTP_PORT=1025
NUXT_SMTP_FROM=Hilko <noreply@hilko.local>

# Optional: allow more self-registrations when at least one user exists (handy for local dev)
# NUXT_ALLOW_SIGNUP=true

# Prod compose (compose.prod.yml)
# POSTGRES_PASSWORD=
# NUXT_PUBLIC_APP_HOST=hilko.example.com